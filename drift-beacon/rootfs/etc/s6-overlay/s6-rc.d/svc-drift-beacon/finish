#!/usr/bin/with-contenv bashio
# shellcheck shell=bash

# Halt the container when the server fails, so the Supervisor sees it (logs the code, shows the app as failed, restarts
# it with Watchdog on); s6 would otherwise restart Node unseen. 0 is a clean stop and 256 is s6 ending the service with
# a signal during a stop.
EXIT_CODE="${1}"

if [[ "${EXIT_CODE}" -eq 0 ]] || [[ "${EXIT_CODE}" -eq 256 ]]; then
  exit 0
fi

bashio::log.error "Drift Beacon exited with code ${EXIT_CODE}; stopping the app"
echo "${EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
